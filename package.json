{
  "name": "soren-os",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @soren/core --filter @soren/web dev",
    "dev:core": "pnpm --filter @soren/core dev",
    "dev:web": "pnpm --filter @soren/web dev",
    "build": "pnpm --filter @soren/web build && pnpm --filter @soren/core build",
    "start": "pnpm --filter @soren/core start",
    "test": "pnpm --filter @soren/core test"
  }
}
